{
  "app": {
    "name": "Vachan",
    "mode": "semi_automatic",
    "theme": "dark",
    "default_bible_version": "HIN_IRV"
  },
  "audio": {
    "device_index": null,
    "sample_rate": 16000,
    "channels": 1,
    "chunk_size_seconds": 3.0,
    "silence_threshold_db": -45.0
  },
  "stt": {
    "model_name": "small",
    "device": "auto",
    "compute_type": "float16",
    "language": "hi",
    "task": "transcribe",
    "beam_size": 5
  },
  "parser": {
    "confidence_threshold": 0.75,
    "enable_phonetic_matching": true,
    "detect_hindi_numerals": true
  },
  "output": {
    "window_type": "lower_third",
    "primary_color": "#1E1E2E",
    "text_color": "#FFFFFF",
    "accent_color": "#F38BA8",
    "reference_color": "#F9E2AF",
    "font_family": "Segoe UI",
    "font_size_verse": 24,
    "font_size_reference": 18,
    "display_duration_seconds": 15,
    "fade_transition_ms": 300,
    "auto_hide": true
  }
}
